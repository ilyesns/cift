# Copy to .env and adjust. .env is never committed.

# Host ports, offset so they don't clash with your other Docker project
DB_PORT=5433
ADMINER_PORT=8081

# Database
POSTGRES_USER=cift
POSTGRES_PASSWORD=cift
POSTGRES_DB=cift

# API
API_PORT=8010
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5174"]
DB_ECHO=false